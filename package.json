{
	"devDependencies": {
		"@types/katex": "^0.16.8",
		"eslint": "^10.4.0",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"lint-staged": "^15.5.2",
		"prettier": "^3.8.3"
	},
	"scripts": {
		"prepare": "husky"
	},
	"lint-staged": {
		"backend/**/*.py": [
			"uvx black",
			"uvx ruff check --fix"
		],
		"frontend/src/**/*.{vue,ts,tsx,mts}": [
			"prettier --write",
			"eslint --fix --cache"
		],
		"frontend/**/*.{json,css,md}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"katex": "^0.17.0",
		"markdown-it-ins": "^4.0.0",
		"markdown-it-katex": "^2.0.3"
	}
}
