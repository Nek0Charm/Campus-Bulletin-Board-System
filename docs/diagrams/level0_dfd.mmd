flowchart TB
    subgraph inputs["输入"]
        I1["注册/登录信息"]
        I2["帖子内容"]
        I3["评论/点赞操作"]
        I4["管理指令"]
    end

    subgraph processes["核心处理"]
        P1["1. 身份认证\n注册/登录/JWT校验"]
        P2["2. 内容管理\n帖子CRUD/置顶/加精"]
        P3["3. 互动处理\n评论回复/点赞计数"]
        P4["4. 通知分发\n事件→通知→已读管理"]
        P5["5. 管理操作\n封禁/审核/公告"]
    end

    subgraph outputs["输出"]
        O1["JWT Token + 用户信息"]
        O2["帖子列表/详情"]
        O3["更新后的计数"]
        O4["通知列表/未读数"]
        O5["操作结果"]
    end

    I1 --> P1 --> O1
    I2 --> P2 --> O2
    I3 --> P3 --> O3
    P3 -->|事件| P4 --> O4
    I4 --> P5 --> O5
