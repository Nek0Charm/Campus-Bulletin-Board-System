# 必填：JWT 密钥（至少32字符，请使用随机字符串）
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes

# 数据库配置（默认值适用于开发环境）
POSTGRES_USER=bbs_user
POSTGRES_PASSWORD=bbs_password

# 前端访问地址（用于邮件验证链接和 CORS）
FRONTEND_BASE_URL=http://your-domain.com

# 后端访问地址
BACKEND_BASE_URL=http://your-domain.com

# 前端端口（默认 80）
FRONTEND_PORT=80

# SMTP 邮件配置（不设置则使用内置 Mailpit 测试服务）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=noreply@your-domain.com
# SMTP_USE_TLS=true
